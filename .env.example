# KapuLetu Frontend Environment Variables

# Backend API Proxy Target
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# Authentication Cookie Keys (Server-Side)
ACCESS_TOKEN_COOKIE_NAME=access_token
REFRESH_TOKEN_COOKIE_NAME=refresh_token

# Authorization Cookie Key (Client-Side Accessible)
NEXT_PUBLIC_ROLE_COOKIE_NAME=user_role

# CSRF Shield Header Name
NEXT_PUBLIC_CSRF_HEADER_NAME=X-KapuLetu-BFF
